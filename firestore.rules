rules_version = '2';

// A plan belongs to exactly one anonymous user. Nobody else can read it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      // both sides: the doc must already be yours, and must still be yours after.
      // Checking only resource.data.uid let an owner rewrite the uid field and
      // hand their own document to somebody else.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
